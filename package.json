{
  "name": "waters-prep",
  "version": "1.0.0",
  "description": "Playwright TS test framework: UI network mocking, API CRUD, OPC UA device simulation",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:opcua": "playwright test --project=opcua",
    "allure": "allure serve allure-results",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "clean:allure": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "node-opcua": "^2.176.0"
  },
  "overrides": {
    "hexy": "0.3.5"
  }
}
